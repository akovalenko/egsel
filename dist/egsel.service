# /etc/systemd/system/egsel.service
#
# Candidates group under egsel-candidates.target (see that file for
# enrollment); Wants= pulls the target in, the target pulls and orders
# after its enrolled candidates, so the daemon starts once they have
# settled — without their names appearing here.
#
# The daemon adopts whatever the slot already holds and never acts
# without probe verdicts, so ordering is a nicety for an unbiased
# first seed, not a correctness requirement. Wants= (not Requires=):
# surviving dead candidates is the daemon's whole job.
[Unit]
Description=egsel egress failover selector
After=network-online.target egsel-candidates.target
Wants=network-online.target egsel-candidates.target

[Service]
Type=exec
ExecStart=/usr/local/bin/egsel run -c /etc/egsel.toml
Restart=on-failure
RestartSec=2
StateDirectory=egsel
# Hardened variant: probing needs no CAP_NET_RAW where ping sockets
# are enabled (net.ipv4.ping_group_range), so a non-root user with
# route rights suffices:
#   User=egsel
#   AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
