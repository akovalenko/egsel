# /etc/systemd/system/wireguard-tunnels.target
#
# Group target for the candidate tunnels. systemd dependencies take no
# wildcards (After=wg-quick@*.service does not expand), so the group is
# a target the instances join; a new candidate enrolls itself without
# touching the egsel unit:
#
#   systemctl add-wants wireguard-tunnels.target wg-quick@wgse.service
#
# plus a per-instance drop-in so the tunnel orders before the group
# (/etc/systemd/system/wg-quick@wgse.service.d/egsel.conf):
#
#   [Unit]
#   Before=wireguard-tunnels.target
[Unit]
Description=all WireGuard tunnel instances

[Install]
WantedBy=multi-user.target
